@using FitControl.Shared.Models
@using FitControl.Shared.Services
@using System.Linq
@inject IFitControlApi FitControlApi

<MudContainer MaxWidth="MaxWidth.False" Class="mt-6">
    <MudText Typo="Typo.h4" Class="fc-heading mb-4">Dashboard</MudText>

    <MudGrid Spacing="3">

        <!-- Infos -->
        <MudItem xs="12" sm="6" md="3">
            <MudPaper Class="pa-4 fc-card">
                <MudText Typo="Typo.subtitle2">Subscrições Ativas</MudText>
                <MudText Typo="Typo.h4">@_subscricoesAtivas</MudText>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" sm="6" md="3">
            <MudPaper Class="pa-4 fc-card">
                <MudText Typo="Typo.subtitle2">Aulas</MudText>
                <MudText Typo="Typo.h4">@_aulasNumero</MudText>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" sm="6" md="3">
            <MudPaper Class="pa-4 fc-card">
                <MudText Typo="Typo.subtitle2">Modalidades</MudText>
                <MudText Typo="Typo.h4">@_modalidadesNumero</MudText>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" sm="6" md="3">
            <MudPaper Class="pa-4 fc-card">
                <MudText Typo="Typo.subtitle2">Instrutores</MudText>
                <MudText Typo="Typo.h4">@_instrutoresNumero</MudText>
            </MudPaper>
        </MudItem>


        <!-- Highlights -->
        <MudItem xs="12" md="4">
            <MudPaper Class="pa-4 fc-card mb-3">
                <MudText Typo="Typo.subtitle2">Modalidade com mais inscritos</MudText>
                <MudText Typo="Typo.h6">@_modalidadeMaisInscritos.Item1</MudText>
                <MudText Typo="Typo.caption">@_modalidadeMaisInscritos.Item2 inscrições</MudText>
            </MudPaper>

            <MudPaper Class="pa-4 fc-card">
                <MudText Typo="Typo.subtitle2">Aula com maior ocupação</MudText>
                <MudText Typo="Typo.h6">@_aulaMaisInscritos.Item1</MudText>
                <MudText Typo="Typo.caption">@_aulaMaisInscritos.Item2 inscrições</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" md="6">
            <MudPaper Class="pa-4 fc-card">
                <MudText Typo="Typo.h6" Class="mb-2">Últimas aulas criadas</MudText>
                @foreach (var item in _ultimasAulas)
                {
                    <div class="d-flex justify-space-between mb-2">
                        <MudText>@item.Item1</MudText>
                        <MudText Typo="Typo.caption">@item.Item2.ToString("dd/MM/yyyy")</MudText>
                    </div>
                }
            </MudPaper>
        </MudItem>
        <MudItem xs="12" md="6">
            <MudPaper Class="pa-4 fc-card">
                <MudText Typo="Typo.h6" Class="mb-2">Top 5 Aulas com mais inscritos</MudText>
                @foreach (var item in _aulasMaisInscritos)
                {
                    <div class="d-flex justify-space-between mb-2">
                        <MudText>@item.Item1</MudText>
                        <MudText>@item.Item2</MudText>
                    </div>
                }
            </MudPaper>
        </MudItem>

        <!-- Chart -->
        <MudItem xs="12" md="8">
            <MudPaper Class="pa-4 fc-card">
                <MudText Typo="Typo.h6" Class="mb-2">Top 5 Aulas por Inscritos</MudText>
                <MudChart ChartType="ChartType.Bar"
                          ChartSeries="@_chartSeries"
                          ChartLabels="@_chartLabels"
                          Width="100%"
                          Height="320px"/>
            </MudPaper>
        </MudItem>


    </MudGrid>
</MudContainer>

@code {
    private List<(string, int)> _aulasMaisInscritos = new();
    private int _subscricoesAtivas;
    private (string, int) _modalidadeMaisInscritos = ("-", 0);
    private (string, int) _aulaMaisInscritos = ("-", 0);
    private List<(string, DateTime)> _ultimasAulas = new();
    private int _aulasNumero;
    private int _modalidadesNumero;
    private int _instrutoresNumero;

    private List<Inscricao> _inscricoes = new();
    private List<Aula> _aulas = new();
    private List<Socio> _socios = new();
    private List<Modalidade> _modalidades = new();
    private List<Instrutor> _instrutores = new();

    private List<ChartSeries<double>> _chartSeries = new();
    private string[] _chartLabels = Array.Empty<string>();

    protected override async Task OnInitializedAsync()
    {
        var inscricaosRes = await FitControlApi.GetInscricoes();
        if (inscricaosRes.Content != null) _inscricoes = inscricaosRes.Content;

        var aulasRes = await FitControlApi.GetAulas();
        if (aulasRes.Content != null) _aulas = aulasRes.Content;

        var socioRes = await FitControlApi.GetSocios();
        if (socioRes.Content != null) _socios = socioRes.Content;

        var modRes = await FitControlApi.GetModalidades();
        if (modRes.Content != null) _modalidades = modRes.Content;

        var instrutoresRes = await FitControlApi.GetInstrutors();
        if (instrutoresRes.Content != null) _instrutores = instrutoresRes.Content;

        BuildMetrics();
        BuildChart();
    }

    private void BuildMetrics()
    {
        _aulasMaisInscritos = _inscricoes
            .Join(_aulas, i => i.AulaId, a => a.Id, (i, a) => a.Nome)
            .GroupBy(n => n)
            .Select(g => (Nome: g.Key, Count: g.Count()))
            .OrderByDescending(x => x.Count)
            .Take(5)
            .Select(x => (x.Nome, x.Count))
            .ToList();

        _subscricoesAtivas = _socios.Count(s => s.FimSubscricao >= DateTime.Now);

        _modalidadeMaisInscritos = _inscricoes
            .Join(_aulas, i => i.AulaId, a => a.Id, (i, a) => a)
            .Join(_modalidades, a => a.ModalidadeId, m => m.Id, (a, m) => m.Nome)
            .GroupBy(n => n)
            .Select(g => (Nome: g.Key, Count: g.Count()))
            .OrderByDescending(x => x.Count)
            .Select(x => (x.Nome, x.Count))
            .FirstOrDefault();

        _aulaMaisInscritos = _inscricoes
            .Join(_aulas, i => i.AulaId, a => a.Id, (i, a) => a.Nome)
            .GroupBy(n => n)
            .Select(g => (Nome: g.Key, Count: g.Count()))
            .OrderByDescending(x => x.Count)
            .Select(x => (x.Nome, x.Count))
            .FirstOrDefault();

        _ultimasAulas = _aulas
            .OrderByDescending(a => a.CreatedAt)
            .Take(5)
            .Select(a => (a.Nome, a.CreatedAt))
            .ToList();

        _aulasNumero = _aulas.Count;
        _modalidadesNumero = _modalidades.Count;
        _instrutoresNumero = _instrutores.Count;
    }

    private void BuildChart()
    {
        _chartLabels = _aulasMaisInscritos.Select(x => x.Item1).ToArray();

        _chartSeries = new List<ChartSeries<double>>
        {
            new()
            {
                Name = "Inscritos",
                Data = _aulasMaisInscritos.Select(x => (double)x.Item2).ToArray()
            }
        };
    }
    

}