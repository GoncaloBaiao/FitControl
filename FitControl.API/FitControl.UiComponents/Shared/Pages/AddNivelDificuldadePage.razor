@using FitControl.Shared.Models
@using FitControl.Shared.Services
@using Refit
@inject IFitControlApi FitControlApi
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<div class="mt-15"></div>

<h3>@(Id.HasValue ? "Editar Nível de Dificuldade" : "Adicionar Nível de Dificuldade")</h3>

<EditForm FormName="AddNivelDificuldadeForm" Model="_nivelDificuldade" OnValidSubmit="SaveNivelDificuldade">
    <DataAnnotationsValidator />
    <ValidationSummary />
    <div class="mb-3">
        <label class="form-label fw-bold">Nível</label>
        <InputText class="form-control" @bind-Value="_nivelDificuldade.Nivel" />
    </div>

    <button class="btn btn-primary" type="submit" disabled="@_saving">@(Id.HasValue ? "Gravar" : "Adicionar")</button>
</EditForm>
<button class="btn btn-secondary" onclick="@(()=>NavigationManager.NavigateTo("/niveisDificuldade"))">Voltar</button>

@code {
    [Parameter]
    public int? Id { get; set; }

    private bool _saving;
    private NivelDificuldade _nivelDificuldade = new();

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopRight;
        
        if (Id.HasValue)
        {
            try
            {
                var response = await FitControlApi.GetNivelDificuldade(Id.Value);
                if (response.IsSuccessStatusCode && response.Content is not null)
                {
                    _nivelDificuldade = response.Content;
                }
                else
                {
                    Snackbar.Add("Nivel de Dificuldade não encontrada.", Severity.Error);
                }
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Não foi possível carregar o Nivel. Verifica se a API está a correr. Erro: {ex.Message}", Severity.Error);
            }
        }
    }

    private async Task SaveNivelDificuldade()
    {

        _saving = true;

        try
        {
            var response = Id.HasValue
                ? await FitControlApi.UpdateNivelDificuldade(_nivelDificuldade)
                : await FitControlApi.AddNivelDificuldade(_nivelDificuldade);

            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add(Id.HasValue 
                    ? "Nível de Dificuldade editado com sucesso"
                    : "Nível de Dificuldade adicionado com sucesso", Severity.Success);
            }
            else
            {
                Snackbar.Add($"Não foi possível guardar o Nivel. API devolveu {response.StatusCode}.", Severity.Error);
            }
        }
        catch (ApiException ex)
        {
            Snackbar.Add($"Não foi possível guardar o Nivel. API devolveu {(int)ex.StatusCode}: {ex.ReasonPhrase}", Severity.Error);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Não foi possível guardar o Nivel. {ex.Message}", Severity.Error);
        }
        finally
        {
            _saving = false;
        }
        
        //POPUP
        try
        {
            var parameters = new DialogParameters<Dialog>
            {
                { x => x.ContentText, "Deseja sair da página?" },
                { x => x.ButtonOkText, "Sim" },
                { x => x.ButtonCancelText, "Não" },
                { x => x.Color, Color.Error }
            };

            var options = new DialogOptions() { CloseButton = true, MaxWidth = MaxWidth.ExtraSmall };

            var result = await DialogService.ShowAsync<Dialog>("Sair da página", parameters, options);
        
            var res = await result.Result;

            if (res != null && res.Canceled)
            {
                return;
            }
        }
        catch (Exception)
        {
            Snackbar.Add("Erro a criar popup de confirmação de saída", Severity.Error);
        }
                
        NavigationManager.NavigateTo("/niveisDificuldade");
    }
}