@using FitControl.Shared.Services
@using FitControl.Shared.Models
@inject IFitControlApi FitControlApi
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<PageTitle>Nível de Dificuldade</PageTitle>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Class="mb-4" />
}
else
{

    <PaginaListar TItem="NivelDificuldade"
                  Title="Níveis de Dificuldade"
                  AddLabel="ADICIONAR NÍVEL DE DIFICULDADE"
                  AddHref="/niveldificuldades/add"
                  Items="_nivelDificuldade">

        <HeaderContent>
            <MudTh>Nível</MudTh>
            <MudTh Style="text-align:right;">Ações</MudTh>
        </HeaderContent>

        <RowTemplate>
            <MudTd DataLabel="Nível">@context.Nivel</MudTd>
            <MudTd DataLabel="Ações" Style="text-align:right;">
                <MudStack Row="true" Spacing="1" Justify="Justify.FlexEnd">
                    <MudIconButton Href="@($"/nivelDificuldade/edit/{context.Id}")"
                                   Icon="@Icons.Material.Filled.Edit"
                                   Size="Size.Small"
                                   Style="color:#1E90FF;"
                                   Title="Editar" />
                    <MudIconButton OnClick="@(() => OnNivelDificuldadeDelete(context.Id))"
                                   Icon="@Icons.Material.Filled.Delete"
                                   Size="Size.Small"
                                   Style="color:#ef4444;"
                                   Title="Eliminar" />
                </MudStack>
            </MudTd>
        </RowTemplate>
    </PaginaListar>
}

@code {
    private bool _loading = true;
    private bool _hasLoaded;
    private List<NivelDificuldade> _nivelDificuldade = new();

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopRight;
        
        if (_hasLoaded) return;
        _hasLoaded = true;

        try
        {
            var response = await FitControlApi.GetNivelDificuldades();

            if (response.IsSuccessStatusCode && response.Content is not null)
            {
                _nivelDificuldade = response.Content;
            }
            else
            {
                _nivelDificuldade = new List<NivelDificuldade>();
                Snackbar.Add($"API devolveu {response.StatusCode}.", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Não foi possível carregar níveis de dificuldade. Verifica se a API está a correr. Erro: {ex.Message}", Severity.Error);
            _nivelDificuldade = new List<NivelDificuldade>();
        }
        finally
        {
            _loading = false;
        }
    }
    
    private async Task OnNivelDificuldadeDelete(int id)
    {
        try
        {
            var parameters = new DialogParameters<Dialog>
            {
                { x => x.ContentText, "Tem a certeza que quer apagar este registo? Este processo não pode ser desfeito." },
                { x => x.ButtonOkText, "Apagar" },
                { x => x.Color, Color.Error }
            };

            var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.ExtraSmall };
            var dialog = await DialogService.ShowAsync<Dialog>("Apagar", parameters, options);
            var result = await dialog.Result;

            if (result.Canceled) return;
        }
        catch
        {
            Snackbar.Add("Erro a criar popup de confirmação de apagar.", Severity.Error);
            return;
        }

        try
        {
            var res = await FitControlApi.DeleteNivelDificuldade(id);

            if (res.IsSuccessStatusCode)
            {
                _nivelDificuldade = _nivelDificuldade.Where(a => a.Id != id).ToList();
                Snackbar.Add("Nível de dificuldade apagado com sucesso", Severity.Success);
            }
            else
            {
                Snackbar.Add("Não foi possível apagar o Nível de dificuldade", Severity.Error);
            }
        }
        catch
        {
            Snackbar.Add("Erro a apagar Nível de dificuldade", Severity.Error);
        }
    }
}
