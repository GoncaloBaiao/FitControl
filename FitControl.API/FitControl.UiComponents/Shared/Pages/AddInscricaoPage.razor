@using FitControl.Shared.Models
@using FitControl.Shared.Services
@inject IFitControlApi FitControlApi
@inject ISnackbar Snackbar
@inject NavigationManager NavigationManager
@inject IDialogService DialogService

<h3>@( Id.HasValue ? "Editar Inscrição" : "Adicionar Inscrição")</h3>
@if (_inscricaoModel != null)
{
    if (_inscricaoModel.Aula != null && _inscricaoModel.Socio != null)
    {
        <EditForm FormName="AddInscricaoForm" Model="_inscricaoModel.Aula" OnValidSubmit="OnAddInscricao">
            <DataAnnotationsValidator />
            <ValidationSummary />
            <MudSelect Label="Aula" @bind-Value="_inscricaoModel.Aula" Placeholder="Selecione a aula"
                       ToStringFunc="@((Aula obj) => obj.Nome ?? null)">
                @foreach (var aula in _aulas)
                {
                    <MudSelectItem Value="aula">@aula.Nome</MudSelectItem>
                }
            </MudSelect>
            <MudSelect Label="Socio" @bind-Value="_inscricaoModel.Socio" Placeholder="Selecione o sócio"
                       ToStringFunc="@((FitControl.Shared.Models.Socio obj) => obj.Nome ?? null)">
                @foreach (var socio in _socios)
                {
                    <MudSelectItem Value="socio">@socio.Nome</MudSelectItem>
                }
            </MudSelect>
            <MudDatePicker @bind-Date="_inscricaoModel.DataInscricao" Label="Data de Inscrição"
                           DateFormat="dd/MM/yyyy"/>
            <MudDatePicker @bind-Date="_inscricaoModel.DataCancelamento" Label="Data de Cancelamento"
                           DateFormat="dd/MM/yyyy"/>
            <button class="btn btn-primary" type="submit">@(Id.HasValue ? "Gravar" : "Adicionar")</button>
        </EditForm>
        <button class="btn btn-secondary" onclick="@(()=>NavigationManager.NavigateTo("/inscricoes"))">Voltar</button>
    }
}

@code {
    [Parameter]
    public int? Id { get; set; }
    
    private Inscricao _inscricaoModel = new();
    private List<Aula> _aulas = new ();
    private List<Socio> _socios = new ();

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopRight;
        
        try
        {
            if (Id.HasValue)
            {
                var inscricaoResponse = await FitControlApi.GetInscricao(Id.Value);
                if (inscricaoResponse.Content != null)
                    _inscricaoModel = inscricaoResponse.Content;
            }
            else
            {
                _inscricaoModel.Aula = new();
                _inscricaoModel.Socio = new();
            }
        
            var aulasResponse = await FitControlApi.GetAulas();
            if (aulasResponse.Content != null)
                _aulas = aulasResponse.Content;

            var sociosResponse = await FitControlApi.GetSocios();
            if (sociosResponse.Content != null)
                _socios = sociosResponse.Content;
        }
        catch (Exception)
        {
            Snackbar.Add("Erro a extrair a lista de Inscrições", Severity.Error);
        }
    }

    private async Task OnAddInscricao()
    {
        _inscricaoModel.AulaId = _inscricaoModel.Aula.Id;
        _inscricaoModel.SocioId = _inscricaoModel.Socio.Id;
        
        if (Id.HasValue)
        {
            try
            {
                var response = await FitControlApi.UpdateInscricao(_inscricaoModel);

                if (response.IsSuccessStatusCode && response.Content != null)
                {
                    Snackbar.Add("Inscrição editada com sucesso", Severity.Success);
                }
                else
                {
                    Snackbar.Add("Não foi possível editar a Inscrição", Severity.Error);
                }
            }
            catch (Exception)
            {
                Snackbar.Add("Erro a editar Inscrição", Severity.Error);
            }
        }
        else
        {
            try
            {
                var response = await FitControlApi.AddInscricao(_inscricaoModel);
            
                if (response.IsSuccessStatusCode)
                {
                    Snackbar.Add("Inscrição adicionada com sucesso", Severity.Success);
                }
                else
                {
                    Snackbar.Add("Não foi possível adicionar a Inscrição", Severity.Error);
                }
            }
            catch (Exception)
            {
                Snackbar.Add("Erro a adicionar Inscrição", Severity.Error);
            }
        }
        
        //POPUP
        try
        {
            var parameters = new DialogParameters<Dialog>
            {
                { x => x.ContentText, "Deseja sair da página?" },
                { x => x.ButtonOkText, "Sim" },
                { x => x.ButtonCancelText, "Não" },
                { x => x.Color, Color.Error }
            };

            var options = new DialogOptions() { CloseButton = true, MaxWidth = MaxWidth.ExtraSmall };

            var result = await DialogService.ShowAsync<Dialog>("Sair da página", parameters, options);
        
            var res = await result.Result;

            if (res != null && res.Canceled)
            {
                return;
            }
        }
        catch (Exception)
        {
            Snackbar.Add("Erro a criar popup de confirmação de saída", Severity.Error);
        }
        
        NavigationManager.NavigateTo("/inscricoes");
    }
}