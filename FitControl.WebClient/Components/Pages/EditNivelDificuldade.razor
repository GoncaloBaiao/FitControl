@page "/niveldificuldade/edit/{Id:int}"
@layout FitControl.WebClient.Components.Layout.MainLayout
@using FitControl.Shared.Models
@using FitControl.Shared.Services
@using Niveldificuldade = FitControl.Shared.Models.NivelDificuldade
@using Refit
@inject IFitControlApi FitControlApi
@inject NavigationManager NavigationManager


<PageTitle>Editar nivel de dificuldade</PageTitle>

<MudStack Spacing="3">
    <MudText Typo="Typo.h4">Editar nivel de dificuldade</MudText>

    @if (!string.IsNullOrWhiteSpace(_errorMessage))
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Filled">@_errorMessage</MudAlert>
    }

    <MudPaper Class="pa-4" Elevation="1">
        <MudForm @ref="_form">
            <MudStack Spacing="3">
                <MudTextField @bind-Value="_nivelDificuldade.Nivel" Label="Nivel" Required="true" RequiredError="O Nivel é obrigatório" />

                <MudStack Row="true" Justify="Justify.FlexEnd" Spacing="2">
                    <MudButton Href="/niveldificuldades" Variant="Variant.Text">Cancelar</MudButton>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@_saving" OnClick="SaveNivel">
                        Guardar
                    </MudButton>
                </MudStack>
            </MudStack>
        </MudForm>
    </MudPaper>
</MudStack>


@code {
    [Parameter]
    public int Id { get; set; }
    private MudForm? _form;
    private bool _loading = true;
    private bool _saving;
    private string? _errorMessage;
    private Shared.Models.NivelDificuldade _nivelDificuldade = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            
            var response = await FitControlApi.GetNivelDificuldade(Id);

            if (response.IsSuccessStatusCode && response.Content is not null)
            {
                _nivelDificuldade = response.Content;
            }
            else
            {
                _errorMessage = "Nivel de dificuldade não encontrada.";
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"Não foi possível carregar o Nivel. Verifica se a API está a correr. Erro: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task SaveNivel()
    {
        if (_form is null)
            return;

        await _form.ValidateAsync();

        if (!_form.IsValid)
            return;
        

        _saving = true;
        _errorMessage = null;

        try
        {

            var response = await FitControlApi.UpdateNivelDificuldade(_nivelDificuldade);

            if (response.IsSuccessStatusCode)
            {
                NavigationManager.NavigateTo("/niveldificuldades");
            }
            else
            {
                _errorMessage = $"Não foi possível atualizar o nivel. API devolveu {response.StatusCode}.";
            }
        }
        catch (ApiException ex)
        {
            _errorMessage = $"Não foi possível atualizar o nivel. API devolveu {(int)ex.StatusCode}: {ex.ReasonPhrase}";
        }
        catch (Exception ex)
        {
            _errorMessage = $"Não foi possível atualizar o nivel. {ex.Message}";
        }
        finally
        {
            _saving = false;
        }
    }
}
