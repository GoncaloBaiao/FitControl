@page "/modalidades"
@using Modalidade = FitControl.Shared.Models.Modalidade
@using FitControl.Shared.Services
@using MudBlazor
@inject IFitControlApi FitControlApi
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@layout FitControl.WebClient.Components.Layout.MainLayout

<PageTitle>Modalidades</PageTitle>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Class="mb-4" />
}
else
{
    <PaginaListar TItem="Modalidade"
                  Title="Modalidades"
                  AddLabel="ADICIONAR MODALIDADE"
                  AddHref="/addModalidade"
                  Items="_modalidades">

        <HeaderContent>
            <MudTh>Nome</MudTh>
            <MudTh>Descrição</MudTh>
            <MudTh>Nível de Dificuldade</MudTh>
            <MudTh Style="text-align:right;">Ações</MudTh>
        </HeaderContent>

        <RowTemplate>
            <MudTd DataLabel="Nome">@context.Nome</MudTd>
            <MudTd DataLabel="Descrição">@context.Descricao</MudTd>
            <MudTd DataLabel="Nível de Dificuldade">@(context.NivelDificuldade?.Nivel ?? "Iniciante")</MudTd>
            <MudTd DataLabel="Ações" Style="text-align:right;">
                <MudIconButton Icon="@Icons.Material.Filled.Edit"
                               Size="Size.Small"
                               Style="color:#1E90FF;"
                               OnClick="@(() => OnEditNavigate(context.Id))" />
                <MudIconButton Icon="@Icons.Material.Filled.Delete"
                               Size="Size.Small"
                               Style="color:#ef4444;"
                               OnClick="@(() => OnModalidadeDelete(context.Id))" />
            </MudTd>
        </RowTemplate>
    </PaginaListar>
    <button class="btn btn-secondary" onclick="@(()=>NavigationManager.NavigateTo("/"))">Voltar</button>
}

@code {
    private bool _loading = true;
    private List<Modalidade> _modalidades = new();

    protected override async Task OnInitializedAsync()
    {
        _loading = true;
        await base.OnInitializedAsync();
        Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopRight;
        
        try
        {
            var response = await FitControlApi.GetModalidades();
            _modalidades = response.Content ?? new List<Modalidade>();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Erro ao carregar modalidades: {ex.Message}", Severity.Error);
            _modalidades = new List<Modalidade>();
        }
        finally
        {
            _loading = false;
        }
    }

    private void OnEditNavigate(int id) => NavigationManager.NavigateTo($"/addModalidade/{id}");

    private async Task OnModalidadeDelete(int id)
    {
        var parameters = new DialogParameters<Dialog>
        {
            { x => x.ContentText, "Tem a certeza que quer apagar este registo? Este processo não pode ser desfeito." },
            { x => x.ButtonOkText, "Apagar" },
            { x => x.Color, Color.Error }
        };

        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.ExtraSmall };
        var dialog = await DialogService.ShowAsync<Dialog>("Apagar", parameters, options);
        var result = await dialog.Result;
        if (result.Canceled) return;

        try
        {
            var apiResponse = await FitControlApi.DeleteModalidade(id);
            if (apiResponse.IsSuccessStatusCode)
            {
                _modalidades = _modalidades.Where(m => m.Id != id).ToList();
                Snackbar.Add("Modalidade apagada com sucesso", Severity.Success);
            }
            else
            {
                Snackbar.Add("Não foi possível apagar a Modalidade", Severity.Error);
            }
        }
        catch
        {
            Snackbar.Add("Erro a apagar Modalidade", Severity.Error);
        }
    }
}