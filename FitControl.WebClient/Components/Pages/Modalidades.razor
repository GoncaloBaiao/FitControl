@page "/modalidades"
@using Modalidade = FitControl.Shared.Models.Modalidade
@using FitControl.Shared.Services
@using MudBlazor
@using Refit
@inject IFitControlApi FitControlApi
@layout FitControl.WebClient.Components.Layout.MainLayout



<PageTitle>Modalidades</PageTitle>

<ErrorBoundary>
    <ChildContent>
        <MudStack Spacing="3">
            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                <MudText Typo="Typo.h4">Modalidades</MudText>
                <MudButton Href="/modalidades/add" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add">
                    Adicionar Modalidade
                </MudButton>
            </MudStack>

            @if (!string.IsNullOrWhiteSpace(_errorMessage))
            {
                <MudAlert Severity="Severity.Error" Variant="Variant.Filled">@_errorMessage</MudAlert>
            }

            <MudPaper Class="pa-4" Elevation="1">
                @if (_loading)
                {
                    <MudProgressLinear Indeterminate="true" />
                }
                else if (_modalidades.Count > 0)
                {
                    <MudTable Items="@_modalidades" Hover="true" Dense="true" Breakpoint="Breakpoint.Sm">
                        <HeaderContent>
                            <MudTh>Nome</MudTh>
                            <MudTh>Descricao</MudTh>
                            <MudTh>Nivel de Dificuldade</MudTh>
                            <MudTh>Ações</MudTh>
                        </HeaderContent>
                        <RowTemplate Context="modalidade">
                            <MudTd>@modalidade.Nome</MudTd>
                            <MudTd>@modalidade.Descricao</MudTd>
                            <MudTd>@(modalidade.NivelDificuldade.Nivel ?? "Iniciante")</MudTd>
                            <MudTd DataLabel="Ações">
                                <MudStack Row="true" Spacing="1">
                                    <MudIconButton Href="@($"/modalidade/edit/{modalidade.Id}")" Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" Size="Size.Small" Title="Editar" />
                                    <MudIconButton Href="@($"/modalidade/softdelete/{modalidade.Id}")" Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" Title="Eliminar" />
                                </MudStack>
                            </MudTd>
                        </RowTemplate>
                    </MudTable>
                }
                else
                {
                    <MudText>Nenhum sócio encontrado.</MudText>
                }
            </MudPaper>
        </MudStack>
    </ChildContent>
    <ErrorContent Context="ex">
        <MudAlert Severity="Severity.Error" Variant="Variant.Filled">
            Erro ao apresentar modalidades: @ex.Message
        </MudAlert>
    </ErrorContent>
</ErrorBoundary>

@code {
    private bool _loading = true;
    private bool _hasLoaded;
    private string? _errorMessage;
    private List<Shared.Models.Modalidade> _modalidades = new();

    protected override async Task OnInitializedAsync()
    {
        if (_hasLoaded) return;
        _hasLoaded = true;

        try
        {
            var response = await FitControlApi.GetModalidades();

            if (response.IsSuccessStatusCode && response.Content is not null)
            {
                _modalidades = response.Content;
            }
            else
            {
                _modalidades = new List<Shared.Models.Modalidade>();
                _errorMessage = $"API devolveu {response.StatusCode}.";
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"Não foi possível carregar sócios. Verifica se a API está a correr. Erro: {ex.Message}";
            _modalidades = new List<Shared.Models.Modalidade>();
        }
        finally
        {
            _loading = false;
        }
    }

    private string FormatDate(DateTime date) => date.ToString("dd/MM/yyyy") ?? "N/A";
}