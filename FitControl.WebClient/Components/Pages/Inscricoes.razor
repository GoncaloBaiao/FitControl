@page "/inscricoes"
@using FitControl.Shared.Services
@using FitControl.Shared.Models
@inject IFitControlApi FitControlApi
@rendermode InteractiveServer
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<PageTitle>Inscrições</PageTitle>

<MudTable Items="@_inscricoes" Hover="true" Breakpoint="Breakpoint.Sm" Loading="@_loading" LoadingProgressColor="Color.Info">
    <HeaderContent>
        <MudTh>Aula</MudTh>
        <MudTh>Sócio</MudTh>
        <MudTh>Data de Inscrição</MudTh>
        <MudTh>Data de Cancelamento</MudTh>
        <MudTh>Ações</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="Aula">@context.Aula.Nome</MudTd>
        <MudTd DataLabel="Socio">@context.Socio.Nome</MudTd>
        <MudTd DataLabel="Data de Inscricao">@context.DataInscricao</MudTd>
        <MudTd DataLabel="Data de Cancelamento">@context.DataCancelamento</MudTd>
        <MudTd DataLabel="Actions">
            <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" Size="Size.Small" OnClick="() => OnEditNavigate(context.Id)"/>
            <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" aria-label="delete" OnClick="()=> OnInscricaoDelete(context.Id)"/>
        </MudTd>
    </RowTemplate>
</MudTable>
<MudIconButton Icon="@Icons.Material.Filled.Add" aria-label="detail" OnClick="OnAddNavigate"/>

@code {

    private List<Inscricao> _inscricoes = new ();
    
    private bool _loading;

    protected override async Task OnInitializedAsync()
    {
        _loading = true;
        
        await base.OnInitializedAsync();
        
        try
        {
            var response = await FitControlApi.GetInscricaos();
            if (response.Content != null)
                _inscricoes = response.Content;
        }
        catch (Exception)
        {
            Snackbar.Clear();
            Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopRight;
            Snackbar.Add("Erro a extrair a lista de Inscrições", Severity.Error);
        }
        
        StateHasChanged();
        
        _loading = false;
    }
    
    private async Task OnInscricaoDelete(int id)
    {
        //POPUP
        try
        {
            var parameters = new DialogParameters<Dialog>
            {
                { x => x.ContentText, "Tem a certeza que quer apagar este registo? Este processo não pode ser desfeito." },
                { x => x.ButtonOkText, "Apagar" },
                { x => x.Color, Color.Error }
            };

            var options = new DialogOptions() { CloseButton = true, MaxWidth = MaxWidth.ExtraSmall };

            var result = await DialogService.ShowAsync<Dialog>("Apagar", parameters, options);

            var res = await result.Result;

            if (res != null && res.Canceled)
            {
                return;
            }
        }
        catch (Exception)
        {
            Snackbar.Clear();
            Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopRight;
            Snackbar.Add("Erro a criar popup de confirmação da ação de apagar", Severity.Error);
        }
        
        try
        {
            var apiResponse = await FitControlApi.DeleteInscricao(id);
            
            if (apiResponse.IsSuccessStatusCode)
            {
                Snackbar.Clear();
                Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopRight;
                Snackbar.Add("Inscrição apagada com sucesso", Severity.Success);
                
                try
                {
                    var response = await FitControlApi.GetInscricaos();
                    if (response.Content != null)
                        _inscricoes = response.Content;
                }
                catch (Exception )
                {
                    Snackbar.Clear();
                    Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopRight;
                    Snackbar.Add("Erro a atualizar a lista de Inscrições", Severity.Error);
                }
            }
            else
            {
                Snackbar.Clear();
                Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopRight;
                Snackbar.Add("Não foi possível apagar a Inscrição", Severity.Error);
            }
        }
        catch (Exception)
        {
            Snackbar.Clear();
            Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopRight;
            Snackbar.Add("Erro a apagar Inscrição", Severity.Error);
        }

        StateHasChanged();
    }
    
    private void OnEditNavigate(int id)
    {
        NavigationManager.NavigateTo($"/addInscricao/{id}");
    }
    
    private void OnAddNavigate()
    {
        NavigationManager.NavigateTo($"/addInscricao");
    }
}
