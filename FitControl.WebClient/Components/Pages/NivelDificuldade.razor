@page "/niveldificuldades"
@using NivelDificuldade = FitControl.Shared.Models.NivelDificuldade
@using FitControl.Shared.Services
@using MudBlazor
@using Refit
@inject IFitControlApi FitControlApi
@layout MainLayout

<PageTitle>Nível de Dificuldade</PageTitle>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Class="mb-4" />
}
else
{

    <PaginaListar TItem="Shared.Models.NivelDificuldade"
                  Title="Níveis de Dificuldade"
                  AddLabel="ADICIONAR NÍVEL DE DIFICULDADE"
                  AddHref="/niveldificuldades/add"
                  Items="_nivelDificuldade">

        <HeaderContent>
            <MudTh>Nível</MudTh>
            <MudTh Style="text-align:right;">Ações</MudTh>
        </HeaderContent>

        <RowTemplate>
            <MudTd DataLabel="Nível">@context.Nivel</MudTd>
            <MudTd DataLabel="Ações" Style="text-align:right;">
                <MudStack Row="true" Spacing="1" Justify="Justify.FlexEnd">
                    <MudIconButton Href="@($"/nivelDificuldade/edit/{context.Id}")"
                                   Icon="@Icons.Material.Filled.Edit"
                                   Size="Size.Small"
                                   Style="color:#1E90FF;"
                                   Title="Editar" />
                    <MudIconButton Href="@($"/nivelDificuldade/softdelete/{context.Id}")"
                                   Icon="@Icons.Material.Filled.Delete"
                                   Size="Size.Small"
                                   Style="color:#ef4444;"
                                   Title="Eliminar" />
                </MudStack>
            </MudTd>
        </RowTemplate>
    </PaginaListar>

    @if (!string.IsNullOrWhiteSpace(_errorMessage))
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Filled" Class="mt-3">@_errorMessage</MudAlert>
    }
}

@code {
    private bool _loading = true;
    private bool _hasLoaded;
    private string? _errorMessage;
    private List<Shared.Models.NivelDificuldade> _nivelDificuldade = new();

    protected override async Task OnInitializedAsync()
    {
        if (_hasLoaded) return;
        _hasLoaded = true;

        try
        {
            var response = await FitControlApi.GetNivelDificuldades();

            if (response.IsSuccessStatusCode && response.Content is not null)
            {
                _nivelDificuldade = response.Content;
            }
            else
            {
                _nivelDificuldade = new List<Shared.Models.NivelDificuldade>();
                _errorMessage = $"API devolveu {response.StatusCode}.";
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"Não foi possível carregar níveis de dificuldade. Verifica se a API está a correr. Erro: {ex.Message}";
            _nivelDificuldade = new List<Shared.Models.NivelDificuldade>();
        }
        finally
        {
            _loading = false;
        }
    }
}