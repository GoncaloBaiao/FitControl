@page "/socios/add"
@page "/socios/edit/{Id:int}"
@layout FitControl.WebClient.Components.Layout.MainLayout
@using FitControl.Shared.Models
@using FitControl.Shared.Services
@using Socio = FitControl.Shared.Models.Socio
@using TipoPlano = FitControl.Shared.Models.TipoPlano
@using Refit
@inject IFitControlApi FitControlApi
@inject NavigationManager NavigationManager


<h3>@(Id.HasValue ? "Editar Sócio" : "Adicionar Sócio")</h3>

@if (!string.IsNullOrWhiteSpace(_errorMessage))
{
    <div class="alert alert-danger">@_errorMessage</div>
}

<EditForm FormName="AddSocioForm" Model="_socio" OnValidSubmit="SaveSocio">
    <div class="mb-3">
        <label class="form-label">Nome</label>
        <InputText class="form-control" @bind-Value="_socio.Nome" />
    </div>
    <div class="mb-3">
        <label class="form-label">Email</label>
        <InputText class="form-control" @bind-Value="_socio.Email" />
    </div>
    <div class="mb-3">
        <label class="form-label">Contacto Telefónico</label>
        <InputText class="form-control" @bind-Value="_socio.ContactoTelefonico" />
    </div>

    <MudSelect Label="Género" @bind-Value="_socio.Genero" Placeholder="Selecione o género">
        <MudSelectItem Value="@("Feminino")">Feminino</MudSelectItem>
        <MudSelectItem Value="@("Masculino")">Masculino</MudSelectItem>
    </MudSelect>

    <div class="mb-3">
        <label class="form-label">Altura</label>
        <InputNumber class="form-control" @bind-Value="_socio.Altura" />
    </div>
    <div class="mb-3">
        <label class="form-label">Peso</label>
        <InputNumber class="form-control" @bind-Value="_socio.Peso" />
    </div>

    <MudDatePicker @bind-Date="_dataNascimento" Label="Data de Nascimento" DateFormat="dd/MM/yyyy" />
    <MudDatePicker @bind-Date="_inicioSubscricao" Label="Início Subscrição" DateFormat="dd/MM/yyyy" />
    <MudDatePicker @bind-Date="_fimSubscricao" Label="Fim Subscrição" DateFormat="dd/MM/yyyy" />

    <MudSelect Label="Tipo de Plano" @bind-Value="_tipoPlanoId" Placeholder="Selecione o tipo de plano">
        @foreach (var plano in _tiposPlano)
        {
            <MudSelectItem Value="@plano.Id">@plano.Designacao</MudSelectItem>
        }
    </MudSelect>

    <button class="btn btn-primary mt-3" type="submit" disabled="@_saving">@(Id.HasValue ? "Gravar" : "Adicionar")</button>
</EditForm>

@code {
    [Parameter]
    public int? Id { get; set; }

    private bool _saving;
    private string? _errorMessage;
    private Shared.Models.Socio _socio = new();
    private List<Shared.Models.TipoPlano> _tiposPlano = new();
    private int _tipoPlanoId;

    private DateTime? _dataNascimento = DateTime.Today;
    private DateTime? _inicioSubscricao = DateTime.Today;
    private DateTime? _fimSubscricao = DateTime.Today;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var response = await FitControlApi.GetTipoPlanos();
            if (response.IsSuccessStatusCode && response.Content is not null)
            {
                _tiposPlano = response.Content;
            }

            if (Id.HasValue)
            {
                var socioResponse = await FitControlApi.GetSocio(Id.Value);
                if (socioResponse.Content != null)
                    _socio = socioResponse.Content;

                if (_socio is null || _socio.Id == 0)
                {
                    _errorMessage = "Sócio não encontrado.";
                }
                else
                {
                    _dataNascimento = _socio.DataNascimento;
                    _inicioSubscricao = _socio.InicioSubscricao;
                    _fimSubscricao = _socio.FimSubscricao;
                    _tipoPlanoId = _socio.TipoPlanoId;
                }
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"Não foi possível carregar os tipos de plano. {ex.Message}";
        }
    }

    private async Task SaveSocio()
    {

        if (_dataNascimento is null || _inicioSubscricao is null || _fimSubscricao is null)
        {
            _errorMessage = "Todas as datas são obrigatórias.";
            return;
        }

        _saving = true;
        _errorMessage = null;

        try
        {
            _socio.DataNascimento = _dataNascimento.Value;
            _socio.InicioSubscricao = _inicioSubscricao.Value;
            _socio.FimSubscricao = _fimSubscricao.Value;
            _socio.TipoPlanoId = _tipoPlanoId;
            /*_socio.CreatedAt = DateTime.Now;
            _socio.UpdatedAt = DateTime.Now;*/

            var response = Id.HasValue
                ? await FitControlApi.UpdateSocio(_socio)
                : await FitControlApi.AddSocio(_socio);

            if (response.IsSuccessStatusCode)
            {
                NavigationManager.NavigateTo("/socios");
            }
            else
            {
                _errorMessage = $"Não foi possível guardar o sócio. API devolveu {response.StatusCode}.";
            }
        }
        catch (ApiException ex)
        {
            _errorMessage = $"Não foi possível guardar o sócio. API devolveu {(int)ex.StatusCode}: {ex.ReasonPhrase}";
        }
        catch (Exception ex)
        {
            _errorMessage = $"Não foi possível guardar o sócio. {ex.Message}";
        }
        finally
        {
            _saving = false;
        }
    }
}
