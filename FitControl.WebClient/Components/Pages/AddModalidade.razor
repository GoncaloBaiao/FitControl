@page "/modalidades/add"
@page "/modalidades/edit/{Id:int}"
@layout FitControl.WebClient.Components.Layout.MainLayout
@using FitControl.Shared.Models
@using FitControl.Shared.Services
@using Modalidade = FitControl.Shared.Models.Modalidade
@using Refit
@inject IFitControlApi FitControlApi
@inject NavigationManager NavigationManager


<h3>@(Id.HasValue ? "Editar Modalidade" : "Adicionar Modalidade")</h3>

@if (!string.IsNullOrWhiteSpace(_errorMessage))
{
    <div class="alert alert-danger">@_errorMessage</div>
}

<EditForm FormName="AddModalidadeForm" Model="_modalidade" OnValidSubmit="SaveModalidade">
    <div class="mb-3">
        <label class="form-label">Nome</label>
        <InputText class="form-control" @bind-Value="_modalidade.Nome" />
    </div>
    <div class="mb-3">
        <label class="form-label">Descrição</label>
        <InputText class="form-control" @bind-Value="_modalidade.Descricao" />
    </div>

    <MudSelect Label="Nível de Dificuldade" @bind-Value="_nivelDificuldadeId" Placeholder="Selecione o nível">
        @foreach (var nivel in _nivelDificuldade)
        {
            <MudSelectItem Value="@nivel.Id">@nivel.Nivel</MudSelectItem>
        }
    </MudSelect>

    <button class="btn btn-primary mt-3" type="submit" disabled="@_saving">@(Id.HasValue ? "Gravar" : "Adicionar")</button>
</EditForm>

@code {
    [Parameter]
    public int? Id { get; set; }

    private bool _saving;
    private string? _errorMessage;
    private Shared.Models.Modalidade _modalidade = new();
    private List<Shared.Models.NivelDificuldade> _nivelDificuldade = new();
    private int _nivelDificuldadeId;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var response = await FitControlApi.GetNivelDificuldades();
            if (response.IsSuccessStatusCode && response.Content is not null)
            {
                _nivelDificuldade = response.Content;
            }

            if (Id.HasValue)
            {
                var modalidadeResponse = await FitControlApi.GetModalidade(Id.Value);
                if (modalidadeResponse.IsSuccessStatusCode && modalidadeResponse.Content is not null)
                {
                    _modalidade = modalidadeResponse.Content;
                    _nivelDificuldadeId = _modalidade.NivelDificuldadeId;
                }
                else
                {
                    _errorMessage = "Modalidade não encontrada.";
                }
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"Não foi possível carregar os niveis de dificuldade. {ex.Message}";
        }
    }

    private async Task SaveModalidade()
    {
        if (_nivelDificuldadeId == 0)
        {
            _errorMessage = "Nivel de Dificuldade Obrigatório";
            return;
        }

        _saving = true;
        _errorMessage = null;

        try
        {
            _modalidade.NivelDificuldadeId = _nivelDificuldadeId;
            /*_modalidade.CreatedAt = DateTime.Now;
            _modalidade.UpdatedAt = DateTime.Now;*/
            var response = Id.HasValue
                ? await FitControlApi.UpdateModalidade(_modalidade)
                : await FitControlApi.AddModalidade(_modalidade);

            if (response.IsSuccessStatusCode)
            {
                NavigationManager.NavigateTo("/Modalidades");
            }
            else
            {
                _errorMessage = $"Não foi possível guardar a modalidade. API devolveu {response.StatusCode}.";
            }
        }
        catch (ApiException ex)
        {
            _errorMessage = $"Não foi possível guardar a modalidade. API devolveu {(int)ex.StatusCode}: {ex.ReasonPhrase}";
        }
        catch (Exception ex)
        {
            _errorMessage = $"Não foi possível guardar a modalidade. {ex.Message}";
        }
        finally
        {
            _saving = false;
        }
    }
}
