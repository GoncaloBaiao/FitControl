@page "/modalidades/add"
@page "/modalidades/edit/{Id:int}"
@layout FitControl.WebClient.Components.Layout.MainLayout
@using FitControl.Shared.Models
@using FitControl.Shared.Services
@using Modalidade = FitControl.Shared.Models.Modalidade
@using Refit
@inject IFitControlApi FitControlApi
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<h3>@(Id.HasValue ? "Editar Modalidade" : "Adicionar Modalidade")</h3>

@if (_modalidade != null)
{
    @if (_modalidade.NivelDificuldade != null)
    {
        <EditForm FormName="AddModalidadeForm" Model="_modalidade" OnValidSubmit="SaveModalidade">
            <DataAnnotationsValidator />
            <ValidationSummary />
            <div class="mb-3">
                <label class="form-label fw-bold">Nome</label>
                <InputText class="form-control" @bind-Value="_modalidade.Nome"/>
            </div>
            <div class="mb-3">
                <label class="form-label fw-bold">Descrição</label>
                <InputText class="form-control" @bind-Value="_modalidade.Descricao"/>
            </div>

            <MudSelect Label="Nível de Dificuldade" @bind-Value="_modalidade.NivelDificuldade" Placeholder="Selecione o nível"
                       ToStringFunc="@((Shared.Models.NivelDificuldade obj) => obj.Nivel ?? null)">
                @foreach (var nivel in _nivelDificuldade)
                {
                    <MudSelectItem Value="@nivel">@nivel.Nivel</MudSelectItem>
                }
            </MudSelect>

            <button class="btn btn-primary mt-3" type="submit" disabled="@_saving">@(Id.HasValue ? "Gravar" : "Adicionar")</button>
        </EditForm>
        <button class="btn btn-secondary" onclick="@(()=>GoBack())">Voltar</button>
    }
}

@code {
    [Parameter]
    public int? Id { get; set; }

    private bool _saving;
    private Shared.Models.Modalidade _modalidade = new();
    private List<Shared.Models.NivelDificuldade> _nivelDificuldade = new();

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopRight;
        
        try
        {
            var response = await FitControlApi.GetNivelDificuldades();
            if (response.IsSuccessStatusCode && response.Content is not null)
            {
                _nivelDificuldade = response.Content;
            }

            if (Id.HasValue)
            {
                var modalidadeResponse = await FitControlApi.GetModalidade(Id.Value);
                if (modalidadeResponse.IsSuccessStatusCode && modalidadeResponse.Content is not null)
                {
                    _modalidade = modalidadeResponse.Content;
                }
                else
                {
                    Snackbar.Add("Modalidade não encontrada.", Severity.Error);
                }
            }
            else
            {
                _modalidade.NivelDificuldade = new();
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add("Não foi possível carregar os niveis de dificuldade.", Severity.Error);
        }
    }

    private async Task SaveModalidade()
    {
        if (_modalidade.NivelDificuldade.Id == 0)
        {
            Snackbar.Add("Nivel de Dificuldade Obrigatório", Severity.Error);
            return;
        }

        _saving = true;

        try
        {
            _modalidade.NivelDificuldadeId = _modalidade.NivelDificuldade.Id;
            /*_modalidade.CreatedAt = DateTime.Now;
            _modalidade.UpdatedAt = DateTime.Now;*/
            var response = Id.HasValue
                ? await FitControlApi.UpdateModalidade(_modalidade)
                : await FitControlApi.AddModalidade(_modalidade);

            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add(Id.HasValue
                    ? "Modalidade editada com sucesso"
                    : "Modalidade adicionada com sucesso", Severity.Success);
            }
            else
            {
                Snackbar.Add($"Não foi possível guardar a modalidade. API devolveu {response.StatusCode}.", Severity.Error);
            }
        }
        catch (ApiException ex)
        {
            Snackbar.Add($"Não foi possível guardar a modalidade. API devolveu {(int)ex.StatusCode}: {ex.ReasonPhrase}", Severity.Error);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Não foi possível guardar a modalidade. {ex.Message}", Severity.Error);
        }
        finally
        {
            _saving = false;
        }
        
        //POPUP
        try
        {
            var parameters = new DialogParameters<Dialog>
            {
                { x => x.ContentText, "Deseja sair da página?" },
                { x => x.ButtonOkText, "Sim" },
                { x => x.ButtonCancelText, "Não" },
                { x => x.Color, Color.Error }
            };

            var options = new DialogOptions() { CloseButton = true, MaxWidth = MaxWidth.ExtraSmall };

            var result = await DialogService.ShowAsync<Dialog>("Sair da página", parameters, options);
        
            var res = await result.Result;

            if (res != null && res.Canceled)
            {
                return;
            }
        }
        catch (Exception)
        {
            Snackbar.Add("Erro a criar popup de confirmação de saída", Severity.Error);
        }
                
        NavigationManager.NavigateTo("/Modalidades");
    }

    private void GoBack()
    {
        NavigationManager.NavigateTo("/Modalidades");
    }

}
