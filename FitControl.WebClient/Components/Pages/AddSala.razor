@page "/salas/add"
@layout FitControl.WebClient.Components.Layout.MainLayout
@using FitControl.Shared.Models
@using FitControl.Shared.Services
@using Sala = FitControl.Shared.Models.Sala
@using Refit
@inject IFitControlApi FitControlApi
@inject NavigationManager NavigationManager


<PageTitle>Adicionar Sala</PageTitle>

<MudStack Spacing="3">
    <MudText Typo="Typo.h4">Adicionar Sala</MudText>

    @if (!string.IsNullOrWhiteSpace(_errorMessage))
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Filled">@_errorMessage</MudAlert>
    }

    <MudPaper Class="pa-4" Elevation="1">
        <MudForm @ref="_form">
            <MudStack Spacing="3">
                <MudTextField @bind-Value="_sala.Nome" Label="Nome" Required="true" RequiredError="Nome é obrigatório" />
                <MudTextField @bind-Value="_sala.Descricao" Label="Descrição" RequiredError="Descrição é obrigatória" />

                <MudStack Row="true" Justify="Justify.FlexEnd" Spacing="2">
                    <MudButton Href="/modalidades" Variant="Variant.Text">Cancelar</MudButton>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@_saving" OnClick="SaveSala">
                        Guardar
                    </MudButton>
                </MudStack>
            </MudStack>
        </MudForm>
    </MudPaper>
</MudStack>


@code {
    private MudForm? _form;
    private bool _saving;
    private string? _errorMessage;
    private Shared.Models.Sala _sala = new();

    protected override async Task OnInitializedAsync()
    {
        
    }

    private async Task SaveSala()
    {
        if (_form is null)
            return;

        await _form.ValidateAsync();
        if (!_form.IsValid)
            return;

        _saving = true;
        _errorMessage = null;

        try
        {
            
            var response = await FitControlApi.AddSala(_sala);

            if (response.IsSuccessStatusCode)
            {
                NavigationManager.NavigateTo("/Salas");
            }
            else
            {
                _errorMessage = $"Não foi possível adicionar a sala. API devolveu {response.StatusCode}.";
            }
        }
        catch (ApiException ex)
        {
            _errorMessage = $"Não foi possível adicionar a sala. API devolveu {(int)ex.StatusCode}: {ex.ReasonPhrase}";
        }
        catch (Exception ex)
        {
            _errorMessage = $"Não foi possível adicionar a sala. {ex.Message}";
        }
        finally
        {
            _saving = false;
        }
    }
}
