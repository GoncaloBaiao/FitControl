@page "/niveldificuldades/add"
@page "/niveldificuldade/edit/{Id:int}"
@layout FitControl.WebClient.Components.Layout.MainLayout
@using FitControl.Shared.Models
@using FitControl.Shared.Services
@using NivelDificuldade = FitControl.Shared.Models.NivelDificuldade
@using Refit
@inject IFitControlApi FitControlApi
@inject NavigationManager NavigationManager

<div class="mt-15"></div>

<h3>@(Id.HasValue ? "Editar Nível de Dificuldade" : "Adicionar Nível de Dificuldade")</h3>

@if (!string.IsNullOrWhiteSpace(_errorMessage))
{
    <div class="alert alert-danger">@_errorMessage</div>
}

<EditForm FormName="AddNivelDificuldadeForm" Model="_nivelDificuldade" OnValidSubmit="SaveNivelDificuldade">
    <div class="mb-3">
        <label class="form-label">Nível</label>
        <InputText class="form-control" @bind-Value="_nivelDificuldade.Nivel" />
    </div>

    <button class="btn btn-primary" type="submit" disabled="@_saving">@(Id.HasValue ? "Gravar" : "Adicionar")</button>
</EditForm>

@code {
    [Parameter]
    public int? Id { get; set; }

    private bool _saving;
    private string? _errorMessage;
    private Shared.Models.NivelDificuldade _nivelDificuldade = new();

    protected override async Task OnInitializedAsync()
    {
        if (Id.HasValue)
        {
            try
            {
                var response = await FitControlApi.GetNivelDificuldade(Id.Value);
                if (response.IsSuccessStatusCode && response.Content is not null)
                {
                    _nivelDificuldade = response.Content;
                }
                else
                {
                    _errorMessage = "Nivel de dificuldade não encontrada.";
                }
            }
            catch (Exception ex)
            {
                _errorMessage = $"Não foi possível carregar o Nivel. Verifica se a API está a correr. Erro: {ex.Message}";
            }
        }
    }

    private async Task SaveNivelDificuldade()
    {

        _saving = true;
        _errorMessage = null;

        try
        {
            var response = Id.HasValue
                ? await FitControlApi.UpdateNivelDificuldade(_nivelDificuldade)
                : await FitControlApi.AddNivelDificuldade(_nivelDificuldade);

            if (response.IsSuccessStatusCode)
            {
                NavigationManager.NavigateTo("/niveldificuldades");
            }
            else
            {
                _errorMessage = $"Não foi possível guardar o nivel. API devolveu {response.StatusCode}.";
            }
        }
        catch (ApiException ex)
        {
            _errorMessage = $"Não foi possível guardar o nivel. API devolveu {(int)ex.StatusCode}: {ex.ReasonPhrase}";
        }
        catch (Exception ex)
        {
            _errorMessage = $"Não foi possível guardar o nivel. {ex.Message}";
        }
        finally
        {
            _saving = false;
        }
    }
}
