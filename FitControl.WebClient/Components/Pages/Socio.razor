@page "/socios"
@using Socio = FitControl.Shared.Models.Socio
@using FitControl.Shared.Services
@using MudBlazor
@using Refit
@inject IFitControlApi FitControlApi
@layout FitControl.WebClient.Components.Layout.MainLayout



<PageTitle>Sócios</PageTitle>

<ErrorBoundary>
    <ChildContent>
        <MudStack Spacing="3">
            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                <MudText Typo="Typo.h4">Gestão de Sócios</MudText>
                <MudButton Href="/socios/add" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add">
                    Adicionar Sócio
                </MudButton>
            </MudStack>

            @if (!string.IsNullOrWhiteSpace(_errorMessage))
            {
                <MudAlert Severity="Severity.Error" Variant="Variant.Filled">@_errorMessage</MudAlert>
            }

            <MudPaper Class="pa-4" Elevation="1">
                @if (_loading)
                {
                    <MudProgressLinear Indeterminate="true" />
                }
                else if (_socios.Count > 0)
                {
                    <MudTable Items="@_socios" Hover="true" Dense="true" Breakpoint="Breakpoint.Sm">
                        <HeaderContent>
                            <MudTh>Nome</MudTh>
                            <MudTh>Email</MudTh>
                            <MudTh>Contacto</MudTh>
                            <MudTh>Data Nascimento</MudTh>
                            <MudTh>Genero</MudTh>
                            <MudTh>Altura</MudTh>
                            <MudTh>Peso</MudTh>
                            <MudTh>Início Subscrição</MudTh>
                            <MudTh>Fim Subscrição</MudTh>
                            <MudTh>Tipo Plano</MudTh>
                            <MudTh>Ações</MudTh>
                        </HeaderContent>
                        <RowTemplate Context="socio">
                            <MudTd>@socio.Nome</MudTd>
                            <MudTd>@socio.Email</MudTd>
                            <MudTd>@socio.ContactoTelefonico</MudTd>
                            <MudTd>@FormatDate(socio.DataNascimento)</MudTd>
                            <MudTd>@socio.Genero?.Designacao</MudTd>
                            <MudTd>@socio.Altura</MudTd>
                            <MudTd>@socio.Peso</MudTd>
                            <MudTd>@FormatDate(socio.InicioSubscricao)</MudTd>
                            <MudTd>@FormatDate(socio.FimSubscricao)</MudTd>
                            <MudTd>@(socio.TipoPlano?.Designacao ?? "N/A")</MudTd>
                            <MudTd DataLabel="Ações">
                                <MudStack Row="true" Spacing="1">
                                    <MudIconButton Href="@($"/socios/edit/{socio.Id}")" Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" Size="Size.Small" Title="Editar" />
                                    <MudIconButton Href="@($"/socios/delete/{socio.Id}")" Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" Title="Eliminar" />
                                </MudStack>
                            </MudTd>
                        </RowTemplate>
                    </MudTable>
                }
                else
                {
                    <MudText>Nenhum sócio encontrado.</MudText>
                }
            </MudPaper>
        </MudStack>
    </ChildContent>
    <ErrorContent Context="ex">
        <MudAlert Severity="Severity.Error" Variant="Variant.Filled">
            Erro ao apresentar sócios: @ex.Message
        </MudAlert>
    </ErrorContent>
</ErrorBoundary>

@code {
    private bool _loading = true;
    private bool _hasLoaded;
    private string? _errorMessage;
    private List<Shared.Models.Socio> _socios = new();

    protected override async Task OnInitializedAsync()
    {
        if (_hasLoaded) return;
        _hasLoaded = true;

        try
        {
            var response = await FitControlApi.GetSocios();

            if (response.IsSuccessStatusCode && response.Content is not null)
            {
                _socios = response.Content;
            }
            else
            {
                _socios = new List<Shared.Models.Socio>();
                _errorMessage = $"API devolveu {response.StatusCode}.";
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"Não foi possível carregar sócios. Verifica se a API está a correr. Erro: {ex.Message}";
            _socios = new List<Shared.Models.Socio>();
        }
        finally
        {
            _loading = false;
        }
    }

    private string FormatDate(DateTime date) => date.ToString("dd/MM/yyyy") ?? "N/A";
}