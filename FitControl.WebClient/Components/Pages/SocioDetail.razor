@page "/sociodetail"
@page "/sociodetail/{Id:int}"
@using FitControl.Shared.Models
@using FitControl.Shared.Services
@inject IFitControlApi FitControlApi
@inject ISnackbar Snackbar
@rendermode InteractiveServer

<MudText Class="fc-heading" Style="font-size:1.75rem;">@_socioDetail.Nome (Detalhes)</MudText>

@if (_socioDetail != null)
{
    if (_socioDetail.TipoPlano != null && _socioDetail.Genero != null)
    {
        <EditForm FormName="ShowSocioDetailForm" Model="_socioDetail" OnValidSubmit="ShowSocioDetail">
            <div class="mb-3">
                <label for="nomeSocio" class="form-label fw-bold">Nome</label>
                <MudTextField class="form-control-lg" id="nomeSocio" @bind-Value="@_socioDetail.Nome" Disabled="true"/>
            </div>
            <div class="mb-3">
                <label for="generoSocio" class="form-label fw-bold">Genero</label>
                <MudTextField class="form-control-lg" id="generoSocio" @bind-Value="@_socioDetail.Genero.Designacao" Disabled="true"/>
            </div>
            <div class="mb-3">
                <label for="dataNascimentoSocio" class="form-label fw-bold">DataNascimento</label>
                <MudTextField class="form-control-lg" id="dataNascimentoSocio" @bind-Value="@_socioDetail.DataNascimento" Disabled="true">@FormatDate(_socioDetail.DataNascimento)</MudTextField>
            </div>
            <div class="mb-3">
                <label for="alturaSocio" class="form-label fw-bold">Altura</label>
                <MudTextField class="form-control-lg" id="alturaSocio" @bind-Value="@_socioDetail.Altura" Disabled="true"/>
            </div>
            <div class="mb-3">
                <label for="pesoSocio" class="form-label fw-bold">Peso</label>
                <MudTextField class="form-control-lg" id="pesoSocio" @bind-Value="@_socioDetail.Peso" Disabled="true"/>
            </div>
            <div class="mb-3">
                <label for="tipoPlanoSocio" class="form-label fw-bold">TipoPlano</label>
                <MudTextField class="form-control-lg" id="tipoPlanoSocio" @bind-Value="@_socioDetail.TipoPlano.Designacao" Disabled="true"/>
            </div>
            <div class="mb-3">
                <label for="emailSocio" class="form-label fw-bold">Email</label>
                <MudTextField class="form-control-lg" id="emailSocio" @bind-Value="@_socioDetail.Email" Disabled="true"/>
            </div>
            <div class="mb-3">
                <label for="contactoTelefonicoSocio" class="form-label fw-bold">ContactoTelefonico</label>
                <MudTextField class="form-control-lg" id="contactoTelefonicoSocio" @bind-Value="@_socioDetail.ContactoTelefonico" Disabled="true"/>
            </div>
            <div class="mb-3">
                <label for="inicioSubscricaoSocio" class="form-label fw-bold">InicioSubscricao</label>
                <MudTextField class="form-control-lg" id="inicioSubscricaoSocio" @bind-Value="@_socioDetail.InicioSubscricao" Disabled="true">@FormatDate(_socioDetail.InicioSubscricao)</MudTextField>
            </div>
            <div class="mb-3">
                <label for="fimSubscricaoSocio" class="form-label fw-bold">FimSubscricao</label>
                <MudTextField class="form-control-lg" id="fimSubscricaoSocio" @bind-Value="@_socioDetail.FimSubscricao" Disabled="true">@FormatDate(_socioDetail.FimSubscricao)</MudTextField>
            </div>
        </EditForm> 
    }
}

@code {
    [Parameter] public int? Id { get; set; }

    private string FormatDate(DateTime? date) => date?.ToString("dd/MM/yyyy");

    private Socio _socioDetail = new();

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

        try
        {
            if (Id.HasValue)
            {
                var detailResponse = await FitControlApi.GetSocio(Id.Value);
                if (detailResponse.Content != null)
                    _socioDetail = detailResponse.Content;
            }
        }
        catch (Exception)
        {
            Snackbar.Clear();
            Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopRight;
            Snackbar.Add("Erro a extrair detalhes", Severity.Error);
        }
    }

    private void ShowSocioDetail()
    {

    }
}