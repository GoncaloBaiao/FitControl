@page "/tipoplanos"
@using FitControl.Shared.Services
@using FitControl.Shared.Models
@inject IFitControlApi FitControlApi
@rendermode InteractiveServer
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<PageTitle>Home</PageTitle>

<MudTable Items="@_tipoPlanos" Hover="true" Breakpoint="Breakpoint.Sm" Loading="@_loading" LoadingProgressColor="Color.Info">
    <HeaderContent>
        <MudTh>Designação</MudTh>
        <MudTh>Preço</MudTh>
        <MudTh>Ações</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="Designacao">@context.Designacao</MudTd>
        <MudTd DataLabel="Preco">@context.Preco</MudTd>
        <MudTd DataLabel="Actions">
            <MudIconButton Icon="@Icons.Material.Filled.RemoveRedEye" aria-label="detail" OnClick="() => OnEditNavigate(context.Id)"/>
            <MudIconButton Icon="@Icons.Material.Filled.Delete" Color='Color.Error' aria-label="delete" OnClick="()=> OnTipoPlanoDelete(context.Id)"/>
        </MudTd>
    </RowTemplate>
</MudTable>
<MudIconButton Icon="@Icons.Material.Filled.Add" aria-label="detail" OnClick="OnAddNavigate"/>

@code {

    private List<Shared.Models.TipoPlano> _tipoPlanos = new ();
    
    private bool _loading;

    protected override async Task OnInitializedAsync()
    {
        _loading = true;
        
        await base.OnInitializedAsync();
        
        try
        {
            var response = await FitControlApi.GetTipoPlanos();
            if (response.Content != null)
                _tipoPlanos = response.Content;
        }
        catch (Exception)
        {
            Snackbar.Clear();
            Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopRight;
            Snackbar.Add("Erro a extrair a lista de Tipos de Plano", Severity.Error);
        }
        
        StateHasChanged();
        
        _loading = false;
    }
    
    private async Task OnTipoPlanoDelete(int id)
    {
        //POPUP
        try
        {
            var parameters = new DialogParameters<Dialog>
            {
                { x => x.ContentText, "Tem a certeza que quer apagar este registo? Este processo não pode ser desfeito." },
                { x => x.ButtonOkText, "Delete" },
                { x => x.Color, Color.Error }
            };

            var options = new DialogOptions() { CloseButton = true, MaxWidth = MaxWidth.ExtraSmall };

            var result = await DialogService.ShowAsync<Dialog>("Delete", parameters, options);

            var res = await result.Result;

            if (res != null && res.Canceled)
            {
                return;
            }
        }
        catch (Exception)
        {
            Snackbar.Clear();
            Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopRight;
            Snackbar.Add("Erro a criar popup de confirmação da ação de apagar", Severity.Error);
        }
        
        try
        {
            var apiResponse = await FitControlApi.DeleteTipoPlano(id);
            
            if (apiResponse.IsSuccessStatusCode)
            {
                Snackbar.Clear();
                Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopRight;
                Snackbar.Add("Tipo de Plano apagado com sucesso", Severity.Success);
                
                try
                {
                    var response = await FitControlApi.GetTipoPlanos();
                    if (response.Content != null)
                        _tipoPlanos = response.Content;
                }
                catch (Exception )
                {
                    Snackbar.Clear();
                    Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopRight;
                    Snackbar.Add("Erro a atualizar a lista de Tipos de Plano", Severity.Error);
                }
            }
            else
            {
                Snackbar.Clear();
                Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopRight;
                Snackbar.Add("Não foi possível apagar o Tipo de Plano", Severity.Error);
            }
        }
        catch (Exception)
        {
            Snackbar.Clear();
            Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopRight;
            Snackbar.Add("Erro a apagar Tipo de Plano", Severity.Error);
        }

        StateHasChanged();
    }
    
    private void OnEditNavigate(int id)
    {
        NavigationManager.NavigateTo($"/addTipoPlano/{id}");
    }
    
    private void OnAddNavigate()
    {
        NavigationManager.NavigateTo($"/addTipoPlano");
    }
}
