@page "/sala/edit/{Id:int}"
@layout FitControl.WebClient.Components.Layout.MainLayout
@using FitControl.Shared.Models
@using FitControl.Shared.Services
@using Sala = FitControl.Shared.Models.Sala
@using Refit
@inject IFitControlApi FitControlApi
@inject NavigationManager NavigationManager


<PageTitle>Editar Sala</PageTitle>

<MudStack Spacing="3">
    <MudText Typo="Typo.h4">Editar Sala</MudText>

    @if (!string.IsNullOrWhiteSpace(_errorMessage))
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Filled">@_errorMessage</MudAlert>
    }

    <MudPaper Class="pa-4" Elevation="1">
        <MudForm @ref="_form">
            <MudStack Spacing="3">
                <MudTextField @bind-Value="_sala.Nome" Label="Nome" Required="true" RequiredError="Nome é obrigatório" />
                <MudTextField @bind-Value="_sala.Descricao" Label="Descrição" RequiredError="Descrição é obrigatória" />
                

                <MudStack Row="true" Justify="Justify.FlexEnd" Spacing="2">
                    <MudButton Href="/salas" Variant="Variant.Text">Cancelar</MudButton>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@_saving" OnClick="SaveSala">
                        Guardar
                    </MudButton>
                </MudStack>
            </MudStack>
        </MudForm>
    </MudPaper>
</MudStack>


@code {
    [Parameter]
    public int Id { get; set; }
    private MudForm? _form;
    private bool _loading = true;
    private bool _saving;
    private string? _errorMessage;
    private Shared.Models.Sala _sala = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            
            var response = await FitControlApi.GetSala(Id);

            if (response.IsSuccessStatusCode && response.Content is not null)
            {
                _sala = response.Content;
            }
            else
            {
                _errorMessage = "Sala não encontrada.";
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"Não foi possível carregar a Sala. Verifica se a API está a correr. Erro: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task SaveSala()
    {
        if (_form is null)
            return;

        await _form.ValidateAsync();

        if (!_form.IsValid)
            return;
        

        _saving = true;
        _errorMessage = null;

        try
        {

            var response = await FitControlApi.UpdateSala(_sala);

            if (response.IsSuccessStatusCode)
            {
                NavigationManager.NavigateTo("/salas");
            }
            else
            {
                _errorMessage = $"Não foi possível atualizar a sala. API devolveu {response.StatusCode}.";
            }
        }
        catch (ApiException ex)
        {
            _errorMessage = $"Não foi possível atualizar a sala. API devolveu {(int)ex.StatusCode}: {ex.ReasonPhrase}";
        }
        catch (Exception ex)
        {
            _errorMessage = $"Não foi possível atualizar a sala. {ex.Message}";
        }
        finally
        {
            _saving = false;
        }
    }
}
