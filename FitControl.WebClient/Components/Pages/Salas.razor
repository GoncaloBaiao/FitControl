@page "/salas"
@using Salas = FitControl.Shared.Models.Sala
@using FitControl.Shared.Services
@using MudBlazor
@using Refit
@inject IFitControlApi FitControlApi
@layout FitControl.WebClient.Components.Layout.MainLayout



<PageTitle>Salas</PageTitle>

<ErrorBoundary>
    <ChildContent>
        <MudStack Spacing="3">
            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                <MudText Typo="Typo.h4">Salas</MudText>
                <MudButton Href="/salas/add" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add">
                    Adicionar Sala
                </MudButton>
            </MudStack>

            @if (!string.IsNullOrWhiteSpace(_errorMessage))
            {
                <MudAlert Severity="Severity.Error" Variant="Variant.Filled">@_errorMessage</MudAlert>
            }

            <MudPaper Class="pa-4" Elevation="1">
                @if (_loading)
                {
                    <MudProgressLinear Indeterminate="true" />
                }
                else if (_salas.Count > 0)
                {
                    <MudTable Items="@_salas" Hover="true" Dense="true" Breakpoint="Breakpoint.Sm">
                        <HeaderContent>
                            <MudTh>Nome</MudTh>
                            <MudTh>Descricao</MudTh>
                            <MudTh>Ações</MudTh>
                        </HeaderContent>
                        <RowTemplate Context="sala">
                            <MudTd>@sala.Nome</MudTd>
                            <MudTd>@sala.Descricao</MudTd>
                            <MudTd DataLabel="Ações">
                                <MudStack Row="true" Spacing="1">
                                    <MudIconButton Href="@($"/sala/edit/{sala.Id}")" Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" Size="Size.Small" Title="Editar" />
                                    <MudIconButton Href="@($"/sala/softdelete/{sala.Id}")" Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" Title="Eliminar" />
                                </MudStack>
                            </MudTd>
                        </RowTemplate>
                    </MudTable>
                }
                else
                {
                    <MudText>Nenhum sócio encontrado.</MudText>
                }
            </MudPaper>
        </MudStack>
    </ChildContent>
    <ErrorContent Context="ex">
        <MudAlert Severity="Severity.Error" Variant="Variant.Filled">
            Erro ao apresentar as salas: @ex.Message
        </MudAlert>
    </ErrorContent>
</ErrorBoundary>

@code {
    private bool _loading = true;
    private bool _hasLoaded;
    private string? _errorMessage;
    private List<Shared.Models.Sala> _salas = new();

    protected override async Task OnInitializedAsync()
    {
        if (_hasLoaded) return;
        _hasLoaded = true;

        try
        {
            var response = await FitControlApi.GetSalas();

            if (response.IsSuccessStatusCode && response.Content is not null)
            {
                _salas = response.Content;
            }
            else
            {
                _salas = new List<Shared.Models.Sala>();
                _errorMessage = $"API devolveu {response.StatusCode}.";
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"Não foi possível carregar sócios. Verifica se a API está a correr. Erro: {ex.Message}";
            _salas = new List<Shared.Models.Sala>();
        }
        finally
        {
            _loading = false;
        }
    }
}