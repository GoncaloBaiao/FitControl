@page "/addUser"
@page "/addUser/{Id:int}"
@using FitControl.Shared.Models
@using FitControl.Shared.Services
@rendermode InteractiveServer
@inject IFitControlApi FitControlApi
@inject ISnackbar Snackbar
@inject NavigationManager NavigationManager
@inject IDialogService DialogService

<h3>@( Id.HasValue ? "Editar User" : "Adicionar User")</h3>

<EditForm FormName="AddUserForm" Model="_userModel" OnValidSubmit="OnAddUser">
    <div class="mb-3">
        <label for="usernameUser" class="form-label">Username</label>
        <InputText class="form-control" id="usernameUser" @bind-Value="@_userModel.Username"/>
    </div>
    <div class="mb-3">
        <label for="passwordUser" class="form-label">Password</label>
        <InputText class="form-control" id="passwordUser" @bind-Value="_userModel.Password"/>
    </div>
    <button class="btn btn-primary" type="submit">@(Id.HasValue ? "Gravar" : "Adicionar")</button>
</EditForm>

@code {
    [Parameter]
    public int? Id { get; set; }
    
    private User _userModel = new();

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

        try
        {
            if (Id.HasValue)
            {
                var userResponse = await FitControlApi.GetUser(Id.Value);
                if (userResponse.Content != null) 
                    _userModel = userResponse.Content;
            }
        }
        catch (Exception)
        {
            Snackbar.Clear();
            Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopRight;
            Snackbar.Add("Erro a extrair a lista de Users", Severity.Error);
        }
    }

    private async Task OnAddUser()
    {
        if (Id.HasValue)
        {
            try
            {
                var response = await FitControlApi.UpdateUser(_userModel);

                if (response.IsSuccessStatusCode && response.Content != null)
                {
                    Snackbar.Clear();
                    Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopRight;
                    Snackbar.Add("User editado com sucesso", Severity.Success);
                }
                else
                {
                    Snackbar.Clear();
                    Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopRight;
                    Snackbar.Add("Não foi possível editar o User", Severity.Error);
                }
            }
            catch (Exception)
            {
                Snackbar.Clear();
                Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopRight;
                Snackbar.Add("Erro a editar User", Severity.Error);
            }
        }
        else
        {
            try
            {
                var response = await FitControlApi.AddUser(_userModel);
            
                if (response.IsSuccessStatusCode)
                {
                    Snackbar.Clear();
                    Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopRight;
                    Snackbar.Add("User adicionado com sucesso", Severity.Success);
                }
                else
                {
                    Snackbar.Clear();
                    Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopRight;
                    Snackbar.Add("Não foi possível adicionar o User", Severity.Error);
                }
            }
            catch (Exception)
            {
                Snackbar.Clear();
                Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopRight;
                Snackbar.Add("Erro a adicionar User", Severity.Error);
            }
        }
        
        //POPUP
        try
        {
            var parameters = new DialogParameters<Dialog>
            {
                { x => x.ContentText, "Deseja sair da página?" },
                { x => x.ButtonOkText, "Sim" },
                { x => x.ButtonCancelText, "Não" },
                { x => x.Color, Color.Error }
            };

            var options = new DialogOptions() { CloseButton = true, MaxWidth = MaxWidth.ExtraSmall };

            var result = await DialogService.ShowAsync<Dialog>("Sair da página", parameters, options);
        
            var res = await result.Result;

            if (res != null && res.Canceled)
            {
                return;
            }
        }
        catch (Exception)
        {
            Snackbar.Clear();
            Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopRight;
            Snackbar.Add("Erro a criar popup de confirmação de saída", Severity.Error);
        }
        
        NavigationManager.NavigateTo("/Users");
    }
}