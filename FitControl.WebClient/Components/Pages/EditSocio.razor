@page "/socios/edit/{Id:int}"
@layout FitControl.WebClient.Components.Layout.MainLayout
@using FitControl.Shared.Models
@using FitControl.Shared.Services
@using Socio = FitControl.Shared.Models.Socio
@using Refit
@inject IFitControlApi FitControlApi
@inject NavigationManager NavigationManager
<link href="home.css" rel="stylesheet" />
<link rel="stylesheet" href="_content/MudBlazor/MudBlazor.min.css" />

<PageTitle>Editar Sócio</PageTitle>

<MudStack Spacing="3">
    <MudText Typo="Typo.h4">Editar Sócio</MudText>

    @if (!string.IsNullOrWhiteSpace(_errorMessage))
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Filled">@_errorMessage</MudAlert>
    }

    @if (_loading)
    {
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
    }
    else
    {
        <MudPaper Class="pa-4" Elevation="1">
            <MudForm @ref="_form">
                <MudStack Spacing="3">
                    <MudTextField @bind-Value="_socio.Nome" Label="Nome" Required="true" RequiredError="Nome é obrigatório" />
                    <MudTextField @bind-Value="_socio.Email" Label="Email" Required="true" RequiredError="Email é obrigatório" />
                    <MudTextField @bind-Value="_socio.ContactoTelefonico" Label="Contacto Telefónico" />

                    <MudGrid>
                        <MudItem xs="12" sm="4">
                            <MudDatePicker @bind-Date="_dataNascimento" Label="Data de Nascimento" Required="true" RequiredError="Data de nascimento é obrigatória" DateFormat="dd/MM/yyyy" />
                        </MudItem>
                        <MudItem xs="12" sm="4">
                            <MudDatePicker @bind-Date="_inicioSubscricao" Label="Início Subscrição" Required="true" RequiredError="Data de início é obrigatória" DateFormat="dd/MM/yyyy" />
                        </MudItem>
                        <MudItem xs="12" sm="4">
                            <MudDatePicker @bind-Date="_fimSubscricao" Label="Fim Subscrição" Required="true" RequiredError="Data de fim é obrigatória" DateFormat="dd/MM/yyyy" />
                        </MudItem>
                    </MudGrid>

                    <MudSelect Label="Tipo de Plano" @bind-Value="_tipoPlanoId" Required="true" RequiredError="Tipo de plano é obrigatório">
                        @foreach (var plano in _tiposPlano)
                        {
                            <MudSelectItem Value="@plano.Id">@plano.Designacao</MudSelectItem>
                        }
                    </MudSelect>

                    <MudStack Row="true" Justify="Justify.FlexEnd" Spacing="2">
                        <MudButton Href="/socios" Variant="Variant.Text">Cancelar</MudButton>
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@_saving" OnClick="SaveSocio">
                            Guardar
                        </MudButton>
                    </MudStack>
                </MudStack>
            </MudForm>
        </MudPaper>
    }
</MudStack>

@code {
    [Parameter]
    public int Id { get; set; }

    private MudForm? _form;
    private bool _loading = true;
    private bool _saving;
    private string? _errorMessage;
    private Shared.Models.Socio _socio = new();
    private List<TipoPlano> _tiposPlano = new();
    private int _tipoPlanoId;

    private DateTime? _dataNascimento;
    private DateTime? _inicioSubscricao;
    private DateTime? _fimSubscricao;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var tiposResponse = await FitControlApi.GetTipoPlanos();
            if (tiposResponse.IsSuccessStatusCode && tiposResponse.Content is not null)
            {
                _tiposPlano = tiposResponse.Content;
            }

            var response = await FitControlApi.GetSocio(Id);
            if (response.Content != null) 
                _socio = response.Content;
            
            if (_socio is null || _socio.Id == 0)
            {
                _errorMessage = "Sócio não encontrado.";
            }
            else
            {
                _dataNascimento = _socio.DataNascimento;
                _inicioSubscricao = _socio.InicioSubscricao;
                _fimSubscricao = _socio.FimSubscricao;
                _tipoPlanoId = _socio.TipoPlanoId;
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"Não foi possível carregar o sócio. Verifica se a API está a correr. Erro: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task SaveSocio()
    {
        if (_form is null)
            return;

        await _form.ValidateAsync();
        if (!_form.IsValid)
            return;

        if (_dataNascimento is null || _inicioSubscricao is null || _fimSubscricao is null)
        {
            _errorMessage = "Todas as datas são obrigatórias.";
            return;
        }

        _saving = true;
        _errorMessage = null;

        try
        {
            _socio.DataNascimento = _dataNascimento.Value;
            _socio.InicioSubscricao = _inicioSubscricao.Value;
            _socio.FimSubscricao = _fimSubscricao.Value;
            _socio.TipoPlanoId = _tipoPlanoId;
            /*
            _socio.UpdatedAt = DateTime.Now;
            */

            var response = await FitControlApi.UpdateSocio(_socio);

            if (response.IsSuccessStatusCode)
            {
                NavigationManager.NavigateTo("/socios");
            }
            else
            {
                _errorMessage = $"Não foi possível atualizar o sócio. API devolveu {response.StatusCode}.";
            }
        }
        catch (ApiException ex)
        {
            _errorMessage = $"Não foi possível atualizar o sócio. API devolveu {(int)ex.StatusCode}: {ex.ReasonPhrase}";
        }
        catch (Exception ex)
        {
            _errorMessage = $"Não foi possível atualizar o sócio. {ex.Message}";
        }
        finally
        {
            _saving = false;
        }
    }
}