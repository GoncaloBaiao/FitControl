@page "/instrutores"
@using FitControl.Shared.Services
@using FitControl.Shared.Models
@inject IFitControlApi FitControlApi
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<PageTitle>Instrutores</PageTitle>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Class="mb-4" />
}
else
{
    
    <PaginaListar TItem="Instrutor"
                  Title="Instrutores"
                  AddLabel="ADICIONAR INSTRUTOR"
                  AddHref="/addInstrutor"
                  Items="_instrutores">
        <HeaderContent>
            <MudTh>Nome</MudTh>
            <MudTh>Data de Nascimento</MudTh>
            <MudTh>Email</MudTh>
            <MudTh>Contacto Telefónico</MudTh>
            <MudTh Style="text-align:right;">Ações</MudTh>
        </HeaderContent>

        <RowTemplate>
            <MudTd DataLabel="Nome">@context.Nome</MudTd>
            <MudTd DataLabel="Data de Nascimento">@context.DataNascimento</MudTd>
            <MudTd DataLabel="Email">@context.Email</MudTd>
            <MudTd DataLabel="Contacto Telefónico">@context.ContactoTelefonico</MudTd>
            <MudTd DataLabel="Ações" Style="text-align:right;">
                <MudIconButton Icon="@Icons.Material.Filled.Edit"
                               Size="Size.Small"
                               Style="color:#1E90FF;"
                               OnClick="@(() => OnEditNavigate(context.Id))" />
                <MudIconButton Icon="@Icons.Material.Filled.Delete"
                               Size="Size.Small"
                               Style="color:#ef4444;"
                               OnClick="@(() => OnInstrutorDelete(context.Id))" />
            </MudTd>
        </RowTemplate>
    </PaginaListar>
}

@code {
    private List<Instrutor> _instrutores = new();
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        _loading = true;
        try
        {
            var response = await FitControlApi.GetInstrutors();
            _instrutores = response.Content ?? new List<Instrutor>();
        }
        catch
        {
            Snackbar.Clear();
            Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopRight;
            Snackbar.Add("Erro a extrair a lista de Instrutores", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task OnInstrutorDelete(int id)
    {
        try
        {
            var parameters = new DialogParameters<Dialog>
            {
                { x => x.ContentText, "Tem a certeza que quer apagar este registo? Este processo não pode ser desfeito." },
                { x => x.ButtonOkText, "Apagar" },
                { x => x.Color, Color.Error }
            };

            var options = new DialogOptions() { CloseButton = true, MaxWidth = MaxWidth.ExtraSmall };
            var result = await DialogService.ShowAsync<Dialog>("Apagar", parameters, options);
            var res = await result.Result;

            if (res != null && res.Canceled) return;
        }
        catch
        {
            Snackbar.Clear();
            Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopRight;
            Snackbar.Add("Erro a criar popup de confirmação de apagar", Severity.Error);
            return;
        }

        try
        {
            var apiResponse = await FitControlApi.DeleteInstrutor(id);

            if (apiResponse.IsSuccessStatusCode)
            {
                Snackbar.Clear();
                Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopRight;
                Snackbar.Add("Instrutor apagado com sucesso", Severity.Success);

                _instrutores = _instrutores.Where(i => i.Id != id).ToList();
            }
            else
            {
                Snackbar.Clear();
                Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopRight;
                Snackbar.Add("Não foi possível apagar o Instrutor", Severity.Error);
            }
        }
        catch
        {
            Snackbar.Clear();
            Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopRight;
            Snackbar.Add("Erro a apagar Instrutor", Severity.Error);
        }
    }

    private void OnEditNavigate(int id) => NavigationManager.NavigateTo($"/addInstrutor/{id}");
}