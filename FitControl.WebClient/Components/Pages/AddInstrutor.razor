@page "/addinstrutor"
@page "/addinstrutor/{Id:int}"
@using FitControl.Shared.Models
@using FitControl.Shared.Services
@layout FitControl.WebClient.Components.Layout.MainLayout
@inject IFitControlApi FitControlApi
@inject ISnackbar Snackbar
@inject NavigationManager NavigationManager
@inject IDialogService DialogService

<div class="mt-15"></div>

<h3>@(Id.HasValue ? "Editar Instrutor" : "Adicionar Instrutor")</h3>

<EditForm FormName="AddInstrutorForm" Model="_instrutorModel" OnValidSubmit="OnAddInstrutor">
    <DataAnnotationsValidator/>
    <ValidationSummary/>

    <div class="mb-3">
        <label class="form-label fw-bold">Nome</label>
        <InputText class="form-control" @bind-Value="_instrutorModel.Nome"/>
    </div>

    <MudDatePicker @bind-Date="_instrutorModel.DataNascimento"
                   Label="Data de Nascimento"
                   DateFormat="dd/MM/yyyy"/>

    <div class="mb-3">
        <label class="form-label fw-bold">Email</label>
        <InputText class="form-control" @bind-Value="_instrutorModel.Email"/>
    </div>

    <div class="mb-3">
        <label class="form-label fw-bold">Contacto</label>
        <InputText class="form-control" @bind-Value="_instrutorModel.ContactoTelefonico"/>
    </div>

    <button class="btn btn-primary" type="submit">@(Id.HasValue ? "Gravar" : "Adicionar")</button>
</EditForm>
<button class="btn btn-secondary" onclick="@(()=>GoBack())">Voltar</button>

@code {
    [Parameter] public int? Id { get; set; }

    private Instrutor _instrutorModel = new();

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopRight;
        
        try
        {
            if (Id.HasValue)
            {
                var instrutorResponse = await FitControlApi.GetInstrutor(Id.Value);
                if (instrutorResponse.Content != null)
                    _instrutorModel = instrutorResponse.Content;
            }
        }
        catch
        {
            Snackbar.Add("Erro a carregar instrutor.", Severity.Error);
        }
    }

    private async Task OnAddInstrutor()
    {
        try
        {
            if (Id.HasValue)
            {
                var response = await FitControlApi.UpdateInstrutor(_instrutorModel);
                Snackbar.Add(response.IsSuccessStatusCode
                    ? "Instrutor editado com sucesso"
                    : "Não foi possível editar o instrutor",
                    response.IsSuccessStatusCode ? Severity.Success : Severity.Error);
            }
            else
            {
                var response = await FitControlApi.AddInstrutor(_instrutorModel);
                Snackbar.Add(response.IsSuccessStatusCode
                    ? "Instrutor adicionado com sucesso"
                    : "Não foi possível adicionar o instrutor",
                    response.IsSuccessStatusCode ? Severity.Success : Severity.Error);
            }
            //POPUP
            try
            {
                var parameters = new DialogParameters<Dialog>
                {
                    { x => x.ContentText, "Deseja sair da página?" },
                    { x => x.ButtonOkText, "Sim" },
                    { x => x.ButtonCancelText, "Não" },
                    { x => x.Color, Color.Error }
                };

                var options = new DialogOptions() { CloseButton = true, MaxWidth = MaxWidth.ExtraSmall };

                var result = await DialogService.ShowAsync<Dialog>("Sair da página", parameters, options);
        
                var res = await result.Result;

                if (res != null && res.Canceled)
                {
                    return;
                }
            }
            catch (Exception)
            {
                Snackbar.Add("Erro a criar popup de confirmação de saída", Severity.Error);
            }
        }
        catch
        {
            Snackbar.Add("Erro ao guardar instrutor.", Severity.Error);
            return;
        }

        NavigationManager.NavigateTo("/instrutores");
    }

    private void GoBack()
    {
        NavigationManager.NavigateTo("/instrutores");
    }

}