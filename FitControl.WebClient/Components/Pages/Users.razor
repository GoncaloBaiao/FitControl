<PaginaListar TItem="User"
              Title="Users"
              AddLabel="ADICIONAR UTILIZADOR"
              AddHref="/addUser"
              Items="_users">

    <HeaderContent>
        <MudTh>Nome</MudTh>
        <MudTh>Password</MudTh>
        <MudTh Style="text-align:right;">Ações</MudTh>
    </HeaderContent>

    <RowTemplate>
        <MudTd DataLabel="Nome">@context.Username</MudTd>
        <MudTd DataLabel="Descricao">@context.Password</MudTd>
        <MudTd DataLabel="Ações" Style="text-align:right;">
            <MudStack Row="true" Spacing="1" Justify="Justify.FlexEnd">
                <MudIconButton Href="@($"/addUser/{context.Id}")"
                               Icon="@Icons.Material.Filled.Edit"
                               Size="Size.Small"
                               Style="color:#1E90FF;"
                               Title="Editar" />
                <MudIconButton OnClick="@(() => OnUserDelete(context.Id))"
                               Icon="@Icons.Material.Filled.Delete"
                               Size="Size.Small"
                               Style="color:#ef4444;"
                               Title="Eliminar" />
            </MudStack>
        </MudTd>
    </RowTemplate>
</PaginaListar>

@code {

    private List<Shared.Models.User> _users = new ();
    
    private bool _loading;

    protected override async Task OnInitializedAsync()
    {
        _loading = true;
        
        await base.OnInitializedAsync();
        Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopRight;
        
        try
        {
            var response = await FitControlApi.GetUsers();
            if (response.Content != null)
                _users = response.Content;
        }
        catch (Exception)
        {
            Snackbar.Add("Erro a extrair a lista de Users", Severity.Error);
        }
        
        StateHasChanged();
        
        _loading = false;
    }
    
    private async Task OnUserDelete(int id)
    {
        //POPUP
        try
        {
            var parameters = new DialogParameters<Dialog>
            {
                { x => x.ContentText, "Tem a certeza que quer apagar este registo? Este processo não pode ser desfeito." },
                { x => x.ButtonOkText, "Delete" },
                { x => x.Color, Color.Error }
            };

            var options = new DialogOptions() { CloseButton = true, MaxWidth = MaxWidth.ExtraSmall };

            var result = await DialogService.ShowAsync<Dialog>("Delete", parameters, options);

            var res = await result.Result;

            if (res != null && res.Canceled)
            {
                return;
            }
        }
        catch (Exception)
        {
            Snackbar.Add("Erro a criar popup de confirmação da ação de apagar", Severity.Error);
        }
        
        try
        {
            var apiResponse = await FitControlApi.DeleteUser(id);
            
            if (apiResponse.IsSuccessStatusCode)
            {
                Snackbar.Add("User apagado com sucesso", Severity.Success);
                
                try
                {
                    var response = await FitControlApi.GetUsers();
                    if (response.Content != null)
                        _users = response.Content;
                }
                catch (Exception )
                {
                    Snackbar.Add("Erro a atualizar a lista de Users", Severity.Error);
                }
            }
            else
            {
                Snackbar.Add("Não foi possível apagar o User", Severity.Error);
            }
        }
        catch (Exception)
        {
            Snackbar.Add("Erro a apagar User", Severity.Error);
        }

        StateHasChanged();
    }
}
