@page "/Dashboard"
@using FitControl.Shared.Models
@using FitControl.Shared.Services
@inject IFitControlApi FitControlApi
@using System.Linq

<h1>Aulas com mais inscritos</h1>
@foreach (var top in _aulasMaisInscritos)
{
    <h3>@top.Item1</h3>
    <h2>@top.Item2</h2>
}

<h1>Subscricoes ativa: @_subscricoesAtivas</h1>

<h1>Modalidade com mais inscritos: @_modalidadeMaisInscritos.Item1 
    (@_modalidadeMaisInscritos.Item2)</h1>

<h1>Aula com mais inscritos: @_aulaMaisInscritos.Item1 
    (@_aulaMaisInscritos.Item2)</h1>

<h1>Últimas aulas criadas</h1>
@foreach (var top in _ultimasAuilas)
{
    <h3>@top.Item1</h3>
    <h2>@top.Item2</h2>
}

@code {
    private List<(string, int)> _aulasMaisInscritos = new ();
    private int _subscricoesAtivas;
    private (string, int) _modalidadeMaisInscritos;
    private (string, int) _aulaMaisInscritos;
    private List<(string, DateTime)> _ultimasAuilas = new ();
    private int _aulasNumero;
    private int _modalidadesNumero;
    private int _instrutoresNumero;
    
    private List<Inscricao> _inscricoes = new();
    private List<Aula> _aulas= new();
    private List<Shared.Models.Socio> _socios= new();
    private List<Modalidade> _modalidades= new();
    private List<Instrutor> _instrutores = new();
    
    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        
        var inscricaosRes = await FitControlApi.GetInscricoes();
        if (inscricaosRes.Content != null)
            _inscricoes = inscricaosRes.Content;

        var aulasRes = await FitControlApi.GetAulas();
        if (aulasRes.Content != null)
            _aulas = aulasRes.Content;

        var socioRes = await FitControlApi.GetSocios();
        if (socioRes.Content != null)
            _socios = socioRes.Content;

        var modRes = await FitControlApi.GetModalidades();
        if (modRes.Content != null) 
            _modalidades = modRes.Content;
        
        var instrutoresRes =  await FitControlApi.GetInstrutors();
        if (instrutoresRes.Content != null)
            _instrutores = instrutoresRes.Content;
        
        AulasMaisInscritos();
        SubscricoesAtivas();
        ModalidadeMaisInscritos();
        AulaMaisInscritos();
        UltimasAulasAdicionadas();
        Aulas();
        Modalidades();
        Instrutores();
    }
    
    //as 5 aulas com maior taxa de ocupação
    private void AulasMaisInscritos()
    {
        _inscricoes
            .Join(
                _aulas,
                inscricoes => inscricoes.AulaId,
                aulas => aulas.Id,
                (inscricoes, aulas) => new { inscricoes, aulas }
            )
            .GroupBy(g => new { g.aulas.Nome })
            .Select(s => new
            {
                s.Key.Nome,
                Inscritos = s.Count(),
            })
            .OrderByDescending(g => g.Inscritos)
            .Take(5)
            .ToList()
            .ForEach(g =>
                _aulasMaisInscritos.Add(new(g.Nome, g.Inscritos)));
    }
    
    //número de sócios com subscrição activa
    private void SubscricoesAtivas()
    {
        _subscricoesAtivas =
            _socios
                .Select(soc => new
                {
                    soc.Id,
                    Socios = soc
                })
                .Count(soc => Convert.ToDateTime(soc.Socios.FimSubscricao) >= DateTime.Now);
    }

    //modalidade com mais inscrições
    private void ModalidadeMaisInscritos()
    {
        _inscricoes
            .Join(
                _aulas,
                i => i.AulaId,
                a => a.Id,
                (inscricoes, aula) => new { inscricoes, aula }
            )
            .Join(
                _modalidades,
                a => a.aula.ModalidadeId,
                m => m.Id,
                (inscricoesAula, modalidades) => new { inscricoesAula, modalidades }
            )
            .Select(s => new
            {
                s.modalidades.Nome,
                s.inscricoesAula.inscricoes.Id,
            })
            .GroupBy(g => g.Nome)
            .OrderByDescending(o => o.Count())
            .Take(1)
            .ToList()
            .ForEach(o => _modalidadeMaisInscritos = (o.Key, o.Count()));
    }
    
    //aula com maior ocupação.
    public void AulaMaisInscritos()
    {
        _inscricoes.Join(
                _aulas,
                i => i.AulaId,
                a => a.Id,
                (inscricao, aula) => new { inscricao, aula }
            )
            .Select(s => new
            {
                s.inscricao.Aula.Nome,
                s.inscricao.Id
            })
            .GroupBy(g => g.Nome)
            .OrderByDescending(o => o.Count())
            .Take(1)
            .ToList()
            .ForEach(o => _aulaMaisInscritos = (o.Key, o.Count()));
    }
    
    //ultimas aulas adicionadas
    private void UltimasAulasAdicionadas()
    {
        _aulas.Select(a => new 
            { a.Nome, 
                a.CreatedAt 
            })
            .OrderByDescending(a => a.CreatedAt)
            .Take(5)
            .ToList()
            .ForEach(a => 
                _ultimasAuilas.Add(new (a.Nome, a.CreatedAt)));

            // (from a in _aulas
            // orderby a.CreatedAt
            // select new
            // {
            //     a.Nome,
            //     a.CreatedAt
            // }).Take(5).ToList().ForEach(a => 
            //     _ultimasAuilas.Add(new (a.Nome, a.CreatedAt)));
    }
    
    //quantas aulas
    private void Aulas()
    {
        _aulasNumero =
            _aulas.Count();
    }
    
    //quantas modalidades
    private void Modalidades()
    {
        _modalidadesNumero =
            _modalidades.Count();
    }
    
    //quantos intrutores
    private void Instrutores()
    {
        _instrutoresNumero =
            _instrutores.Count();
    }
}